# Copy this file to .env. Never commit the real .env file.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,pamarioklumpe.lt,www.pamarioklumpe.lt,valdyti.pamarioklumpe.lt
DJANGO_CSRF_TRUSTED_ORIGINS=https://pamarioklumpe.lt,https://www.pamarioklumpe.lt,https://valdyti.pamarioklumpe.lt

# Local PostgreSQL example. Development and production must use different databases.
DATABASE_URL=postgresql://pamarioklumpe_dev:replace-password@127.0.0.1:5432/pamarioklumpe_dev

# Invoice PDF reading. Put the real key only in .env, never Git.
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=gpt-4o-mini
INVOICE_UPLOAD_MAX_BYTES=15728640

# Receipt photos use the same OPENAI_API_KEY. Never put a real key in this file.
OPENAI_RECEIPT_MODEL=gpt-6.1-sol
OPENAI_RECEIPT_REASONING=medium
RECEIPT_UPLOAD_MAX_BYTES=15728640
RECEIPT_BATCH_MAX_FILES=30
# Optional absolute private storage path (default: project/private_media).
# RECEIPT_STORAGE_ROOT=/path/to/private_media

# Arduino darbo laiko terminalas. Sugeneruokite ilgą atsitiktinį raktą ir laikykite tik .env faile.
CLOCK_DEVICE_API_KEY=
CLOCK_DUPLICATE_WINDOW_SECONDS=15

# Local combined URLs: pamarioklumpe.local_urls
# Production public service: pamarioklumpe.urls
# Production management service: ValdytiAPP.urls
DJANGO_ROOT_URLCONF=pamarioklumpe.local_urls
